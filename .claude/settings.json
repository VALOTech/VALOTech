{
  "model": "claude-opus-5[1m]",
  "alwaysThinkingEnabled": true,
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "max"
  },
  "permissions": {
    "allow": [
      "Bash(git log*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git ls-tree*)",
      "Bash(git cat-file*)",
      "Bash(git merge-base*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(git fetch origin*)",
      "Bash(bash scripts/sync.sh pull*)",
      "Bash(make check*)",
      "Bash(make roadmap*)",
      "Bash(make doctor*)",
      "Bash(python scripts/*)",
      "Bash(node scripts/*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push --mirror*)",
      "Bash(git push --all*)",
      "Bash(git push --delete*)",
      "Bash(git push origin :*)",
      "Bash(git push origin staging*)",
      "Bash(git push origin production*)",
      "Bash(git reset --hard*)",
      "Bash(git reset --merge*)",
      "Bash(git commit --amend*)",
      "Bash(git rebase*)",
      "Bash(git cherry-pick*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git clean -f*)",
      "Bash(git checkout --force*)",
      "Bash(git checkout -f*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git branch -f*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git update-ref -d*)",
      "Bash(git reflog expire*)",
      "Bash(git gc --prune=now*)",
      "Bash(git tag -d*)",
      "Bash(git tag -f*)",
      "Bash(git config --global*)",
      "Bash(git config --system*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",
      "Bash(rm -rf .git*)"
    ]
  }
}
