#!/usr/bin/env sh
# Refuses force-pushes, ref deletions, pushes to any branch outside the allowed
# set, and any commit whose .gitattributes has lost the line-ending canon.
#
# Git passes a hook no flags, so a force-push is not directly observable. It is
# detected structurally instead: an update whose current remote tip is not an
# ancestor of the pushed commit can only land by discarding remote history.

set -eu

# The served English copy is generated from the English dictionary, so the two
# can drift apart in a commit that edits only one of them. Pushing publishes,
# so the drift would ship. Check before the ref walk: it holds for every push.
if ! command -v node >/dev/null 2>&1; then
	echo "pre-push: node is required to verify the served copy" >&2
	echo "pre-push: install Node, or run 'node scripts/sync-static-copy.mjs --check' elsewhere" >&2
	exit 1
fi
if ! node scripts/sync-static-copy.mjs --check; then
	echo "pre-push: index.html does not match assets/i18n.js" >&2
	exit 1
fi

# The loop publishes the site from main and works on development. staging and
# production are promotion targets: the owner merges into them, and a hook that
# let this side push them would make the one-way flow a convention rather than a
# rule. They may still be brought into existence here — a ref that does not yet
# exist cannot be promoted onto, and the model needs all three to exist before
# the first promotion can happen.
ALLOWED_REFS="refs/heads/main refs/heads/development"
CREATE_ONLY_REFS="refs/heads/staging refs/heads/production"
ZERO=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

while read -r _local_ref local_sha remote_ref remote_sha; do
	[ -z "${remote_ref:-}" ] && continue

	case " $ALLOWED_REFS " in
		*" $remote_ref "*) ;;
		*)
			case " $CREATE_ONLY_REFS " in
				*" $remote_ref "*)
					if [ "$remote_sha" != "$ZERO" ]; then
						echo "pre-push: refusing to update $remote_ref" >&2
						echo "pre-push: promotion into it is the owner's, not this side's" >&2
						exit 1
					fi
					;;
				*)
					echo "pre-push: refusing to push $remote_ref" >&2
					echo "pre-push: allowed refs are: $ALLOWED_REFS" >&2
					echo "pre-push: creatable once: $CREATE_ONLY_REFS" >&2
					exit 1
					;;
			esac
			;;
	esac

	if [ "$local_sha" = "$ZERO" ]; then
		echo "pre-push: refusing to delete $remote_ref" >&2
		exit 1
	fi

	if [ "$remote_sha" != "$ZERO" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
		echo "pre-push: refusing non-fast-forward update of $remote_ref" >&2
		echo "pre-push: the remote tip is not an ancestor of $local_sha (force-push)" >&2
		exit 1
	fi

	# The attribute, not the platform, must decide the checkout form. Read the
	# pushed commit rather than the working tree: with eol=lf in force a Windows
	# checkout already shows LF, so the working tree cannot reveal the loss.
	if ! git show "$local_sha:.gitattributes" 2>/dev/null |
		grep -qE '^\*[[:space:]]+text=auto[[:space:]]+eol=lf'; then
		echo "pre-push: $local_sha lacks the line-ending canon" >&2
		echo "pre-push: .gitattributes must pin '* text=auto eol=lf'" >&2
		exit 1
	fi
done

exit 0
