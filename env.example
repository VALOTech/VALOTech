# =============================================================================
# VALO Tech — example environment
# =============================================================================
# Copy to .env and adjust. Every variable the application reads at boot is
# listed here. A required key has no safe default: a missing one aborts startup
# rather than being guessed, because a silently-defaulted secret is worse than a
# refusal to start. An optional key shows its built-in default in the comment.
#
# No real secret belongs in this file. It is committed, and the repository is
# public.
#
# The host ports match docker-compose.yml so an unedited copy works, and they
# are the row this repository claimed in docs/ECOSYSTEM.md rather than an
# engine's default — several VALO stacks run on one machine, and a default is a
# value two compose files reach for independently.
# =============================================================================

# --- Application ---------------------------------------------------------
# Required: development | staging | production. Outside development the
# session cookie carries Secure and the __Host- prefix, and DB_SSLMODE must not
# be 'disable'. There is no `if env == production` branch anywhere else.
APP_ENV=development

# Required. The origin the application serves from, with no trailing slash.
# It is what the session cookie is scoped to and what an invitation link is
# built from, so a wrong value produces mail nobody can act on. Named for what
# it holds -- scheme, host and port, never a path -- because a value that ends
# in a path silently produces links with the path twice.
APP_ORIGIN=http://localhost:3100

# Optional, default 3100. The row this repository claimed in ECOSYSTEM.md.
PORT=3100

# --- Database ------------------------------------------------------------
# Required. Postgres 17. The port is 5434, not 5432: VALO Compliance holds
# 5432 and VALO Ads holds 5433, and a stack that binds a port another stack
# already has either fails to start or silently reaches the wrong database.
DATABASE_URL=postgres://valotech:valotech@localhost:5434/valotech

# Optional, default 'disable' in development and required otherwise.
DB_SSLMODE=disable

# --- Sessions ------------------------------------------------------------
# Required. At least 32 bytes of randomness; generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it signs every live session out, which is the intended emergency
# lever and not a thing to do casually.
SESSION_SECRET=

# Optional, default 43200 (twelve hours, in seconds). How long a session lives
# without activity before it has to be signed in again.
SESSION_TTL_SECONDS=43200

# --- Mail ----------------------------------------------------------------
# SMTP against the company's own mailbox: docs/decisions-log.md#MAIL-DEC-01.
# No third party holds an investor's address, and the cost is that SMTP answers
# once at hand-off and reports nothing afterwards -- so a bounce arrives as an
# e-mail in the MAIL_FROM mailbox and a person acts on it, which MAIL-002 says
# in those words rather than implying the system noticed.
#
# Optional. Absent, mail is disabled and the system stays up: an invitation is
# still created and its link is shown to the admin to deliver by hand.
# Implicit TLS on 465, or STARTTLS on 587. A connection that cannot be secured
# fails the send rather than falling back to plaintext.
SMTP_URL=

# Optional, and required whenever SMTP_URL is set. The envelope sender, and the
# mailbox delivery-status notifications come back to.
MAIL_FROM=

# --- Backups -------------------------------------------------------------
# Optional. Where the daily encrypted dump is written (DATA-003). Absent, no
# backup is taken and `make doctor` says so rather than the system implying
# otherwise. In AWS this is an S3 URI; locally a directory path is fine.
BACKUP_TARGET=

# --- Rate limiting -------------------------------------------------------
# Optional, defaults 5 and 900. Sign-in attempts allowed per account and per
# address within the window, in seconds. A sign-in failure is indistinguishable
# between an unknown account and a wrong password, so the limit is what stops
# the endpoint being a membership oracle.
AUTH_MAX_ATTEMPTS=5
AUTH_WINDOW_SECONDS=900
